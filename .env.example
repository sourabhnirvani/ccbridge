# Copy to .env and fill in. Both people use the SAME room and token,
# and DIFFERENT names.

# Where the relay lives. https:// once it is not on your own machine.
CCBRIDGE_RELAY_URL=http://127.0.0.1:8787

# Shared room. Pick something unguessable - the token is the real lock,
# but a random room name means nobody stumbles into it.
CCBRIDGE_ROOM=kaggle-duo

# Shared secret. Generate with: python -c "import secrets;print(secrets.token_urlsafe(32))"
CCBRIDGE_TOKEN=replace-me

# How you appear to your peer. Must differ between the two of you.
CCBRIDGE_NAME=sourabh

# Optional but recommended: only accept messages from these peer names.
CCBRIDGE_ALLOWED_PEERS=friend
